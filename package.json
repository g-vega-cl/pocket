{
  "name": "knowledge-db-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.15.0"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "web": "pnpm --filter web",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "ingest": "cd services/ingestion && python ingest.py",
    "query": "cd services/ingestion && python query.py"
  },
  "devDependencies": {
    "pnpm": "10.15.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
