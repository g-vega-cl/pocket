# Pocket Server Configuration

# OpenRouter API Key (required for LLM)
OPENROUTER_API_KEY=sk-or-v1-xxxxx

# GitHub Personal Access Token (required for repo access and PR creation)
# Needs repo scope for private repos
GITHUB_TOKEN=ghp_xxxxx

# OpenRouter Model (optional, defaults to anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Server port (optional, defaults to 5173)
PORT=5173
